# Application
NODE_ENV=development
APP_PORT=3000
APP_HOST_PORT=3000

# PostgreSQL (use localhost when running the app outside Docker Compose)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://app_user:change_me@postgres:5432/app_db?schema=public

# RabbitMQ (RABBITMQ_URL, when set, takes precedence over the component settings)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=app_user
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://app_user:change_me@rabbitmq:5672/
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_DB=0
REDIS_URL=redis://:change_me@redis:6379/0
REDIS_HOST_PORT=6379
