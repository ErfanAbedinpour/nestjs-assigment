# Confirm that the API and database below belong to a disposable test stack.
# The E2E suite creates users, credits, and payments in that stack.
SYSTEM_TEST_ISOLATED=yes

# Address of the running test API as seen by the process running Vitest.
SYSTEM_TEST_API_URL=http://localhost:3000

# PostgreSQL database used by the E2E assertions. This must be the same
# disposable database used by the test API and worker. When Vitest runs on
# the host, use localhost and the published PostgreSQL port, not "postgres".
DATABASE_URL=postgresql://test_user:test_password@localhost:5432/test_database

# Admin API key configured on the running test API. Use test-only credentials.
SYSTEM_TEST_ADMIN_KEY=replace-with-test-admin-key

# Expected total number of payment attempts, including the first attempt.
# This must match PAYMENT_MAX_ATTEMPTS on the running test worker.
SYSTEM_TEST_MAX_ATTEMPTS=5

# Worker configuration required by the payment scenarios. Set these on the
# test worker itself; loading this file in Vitest cannot reconfigure a worker
# that is already running.
# PAYMENT_MAX_ATTEMPTS=5
# PAYMENT_RETRY_BASE_DELAY_MS=100
# PAYMENT_RETRY_MAX_DELAY_MS=200
# PAYMENT_FAILURE_PER_MINOR_UNIT=0
# PAYMENT_FORCED_FAILURE_REFERENCES=FAIL
